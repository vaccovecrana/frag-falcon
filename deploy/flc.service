# Reference systemd unit for a rootless frag-falcon deployment.
#
# `deploy/setup.sh` generates the real /etc/systemd/system/flc.service from the
# values it is given; this file mirrors that template (with the default values)
# for manual installs and review. Keep the two in sync.
#
# frag-falcon runs as an unprivileged user; the fg_vmm launcher receives
# CAP_NET_ADMIN (for TAP devices) via AmbientCapabilities, and the service user
# must be in the `kvm` group to access /dev/kvm. The vm-dir is mounted
# nosuid,nodev,noexec (host-wide) so guest-planted special files are inert to
# host-side processes.
#
# CAP_SETUID/CAP_SETGID are in the bounding set so the fg_usermap helper's file
# capabilities take effect (a bounded set that omits them strips the helper's
# caps, and guest images that chown to a non-root uid then fail).
#
# Do NOT also `setcap` fg_vmm: a file-capped binary runs in the loader's
# secure-execution mode and cannot resolve the libkrun libraries beside it.

[Unit]
Description=frag-falcon libkrun microVM hypervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flc
Group=flc
WorkingDirectory=/opt/flc
ExecStart=/opt/flc/flc --vm-dir=/var/lib/flc/vm --oci-dir=/var/lib/flc/oci --api-host=127.0.0.1 --api-port=7070
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID
Restart=on-failure
SyslogIdentifier=flc

# NOTE: do not set PrivateMounts=yes if you want the vm-dir's nosuid,nodev,noexec
# (a system mount) to be visible to host-side tools; a private namespace would
# scope it to this service only.
#
# The --oci-dir holds the read-mostly OCI blob cache and may live on slower
# storage; it does not need the nosuid,nodev,noexec hardening the vm-dir does.

[Install]
WantedBy=multi-user.target
